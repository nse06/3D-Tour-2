# Atrium runs with zero configuration: listings are stored in ./.data (local JSON
# store) and the dashboard uses a single implicit "Demo Realtor".
#
# For production (e.g. Vercel), connect Supabase for Postgres, Auth and Storage:
#   1. Create a Supabase project — on Vercel: Storage → Create Database → Supabase,
#      which sets the variables below for you (its key names work as-is).
#   2. Nothing to run by hand when POSTGRES_URL_NON_POOLING is set: the first visit to
#      the dashboard applies supabase/migrations/. Otherwise /setup shows the SQL to paste
#      into the Supabase SQL editor (every migration is safe to run again).
#   3. Set the variables below.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe key. Either name works:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for the iPhone upload endpoints (the phone has no login). Either name
# works. Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# Direct Postgres connection (Vercel's Supabase integration sets it): lets the app create
# and upgrade its own tables on first use instead of you running the SQL.
POSTGRES_URL_NON_POOLING=
# Storage bucket for captures/covers/scan packages (created by the migration).
SUPABASE_STORAGE_BUCKET=captures

# Public origin, used for absolute link-preview URLs and as the upload address in
# iPhone pairing codes (defaults to the address the dashboard was opened on).
NEXT_PUBLIC_SITE_URL=

# Local mode only (optional): where the JSON store + uploads live, and the
# secret used to sign upload URLs (auto-generated in the data dir if unset).
ATRIUM_DATA_DIR=
ATRIUM_UPLOAD_SECRET=
